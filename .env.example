# CashLenX product website environment example
# Copy to .env for local use. ENV_FILE may select another repository-local file
# when running scripts/build.sh, scripts/start.sh, or scripts/stop.sh.

# Common host overrides.
# WEBSITE_BIND_ADDRESS controls the published host interface; keep 127.0.0.1
# when a host reverse proxy fronts the container. WEBSITE_PORT is an integer
# from 1 to 65535.
WEBSITE_BIND_ADDRESS=127.0.0.1
WEBSITE_PORT=11065

# Docker image settings. Every value is active and may be changed directly.
# Lifecycle frontend selection accepts auto, docker, or nerdctl. Auto detects
# whether the docker command is Docker or a nerdctl wrapper. nerdctl 2.2+ is
# required. CONTAINER_CLI may be set in the invoking shell for a custom path.
CONTAINER_FRONTEND=auto
# Explicit Compose project and shared external-network names. Keep the network
# value identical in the App, Server, and Website environment files. Compose
# project names start with a lowercase letter/digit and use lowercase letters,
# digits, hyphens, or underscores. Network/container names start alphanumeric
# and may additionally use periods. Do not set reserved COMPOSE_PROJECT_NAME;
# it overrides WEBSITE_PROJECT_NAME.
WEBSITE_PROJECT_NAME=cashlenx-website
DOCKER_NETWORK_NAME=cashlenx-network
# Image values use Docker repository:tag conventions. The container name must be
# unique on the Docker host.
WEBSITE_IMAGE_NAME=cashlenx-website
WEBSITE_IMAGE_TAG=latest
WEBSITE_CONTAINER_NAME=cashlenx-website
# Base-image digest pins are tracked in docker/images.env. Override them only
# for a deliberate, separately validated base-image update.

# Container resource and health settings.
# CPU values are decimal CPU cores, memory values use Docker units such as 64m
# or 1g, PID/retry values are positive integers, and time values use Compose
# durations such as 5s, 1m, or 1m30s.
WEBSITE_CPU_LIMIT=0.5
WEBSITE_CPU_RESERVATION=0.1
WEBSITE_MEMORY_LIMIT=256m
WEBSITE_MEMORY_RESERVATION=64m
WEBSITE_PIDS_LIMIT=128
WEBSITE_STOP_GRACE_PERIOD=15s
WEBSITE_HEALTHCHECK_INTERVAL=15s
WEBSITE_HEALTHCHECK_TIMEOUT=5s
WEBSITE_HEALTHCHECK_RETRIES=3
WEBSITE_HEALTHCHECK_START_PERIOD=15s
